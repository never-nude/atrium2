---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import TimelineStrip from '../components/TimelineStrip.astro';
import { collectionHighlights, facets, featuredWorkForDate, recentlyPrepared, works } from '../lib/catalog';
import { withBase } from '../lib/urls';

const featured = featuredWorkForDate();
const highlights = collectionHighlights();
const recent = recentlyPrepared(8);
const pathways = [
  { label: 'Ancient Mediterranean', href: '/museum/?era=ancient&place=mediterranean', note: 'Greek, Roman, and related classical records.' },
  { label: 'Marble', href: '/museum/?material=marble', note: 'Stone bodies, reliefs, fragments, and monuments.' },
  { label: 'Bronze', href: '/museum/?material=bronze', note: 'Cast figures and modern sculpture records.' },
  { label: 'Renaissance', href: '/museum/?era=renaissance', note: 'European makers, workshop records, and devotional objects.' },
  { label: 'The Human Figure', href: '/museum/?q=figure', note: 'Bodies, portraits, torsos, saints, and studies.' },
  { label: 'Asia', href: '/museum/?place=asia', note: 'Objects grouped from Asian source records.' },
];

const description = 'A static-first digital museum for sculpture across five millennia.';
---

<BaseLayout
  title="Atrium.Earth"
  description={description}
  image={featured.posterImage}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Museum',
    name: 'Atrium.Earth',
    url: 'https://atrium.earth/',
    description,
  }}
>
  <section class="home-hero" aria-labelledby="home-title">
    <img src={withBase(featured.posterImage)} alt="" width="720" height="900" loading="eager" decoding="async" />
    <div class="band-inner hero-content">
      <p class="eyebrow">Digital sculpture museum</p>
      <h1 id="home-title">Sculpture you can turn around.</h1>
      <p class="lede">Five millennia of sculpture, free to explore. Open any piece to spin it in 3D, change the light, and look closely — or just browse the photographs.</p>
      <div class="hero-actions">
        <a class="button" href={withBase('/museum/')}>Open the museum</a>
        <a class="button secondary" href={withBase(featured.route)}>Featured object</a>
      </div>
      <div class="hero-caption" aria-label="Featured object">
        <span>{featured.title}</span>
        <span>{featured.maker || featured.sourceMuseum || featured.geography}</span>
        <span>{featured.displayDate}</span>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="featured-title">
    <div class="feature-block">
      <a class="feature-block__media" href={withBase(featured.route)} aria-label={`Open ${featured.title}`}>
        <img src={withBase(featured.posterImage)} alt={`Poster image for ${featured.title}`} width="720" height="900" loading="eager" decoding="async" />
      </a>
      <div>
        <p class="eyebrow">Featured object</p>
        <h2 id="featured-title">{featured.title}</h2>
        <p class="lede">{featured.description}</p>
        <ul class="meta-line" aria-label="Featured object metadata">
          <li>{featured.displayDate}</li>
          <li>{featured.maker || 'Maker not yet recorded'}</li>
          <li>{featured.geography}</li>
          <li>{featured.materials[0] || 'Material not yet recorded'}</li>
        </ul>
        <div class="hero-actions">
          <a class="button" href={withBase(featured.route)}>Open record</a>
          <a class="button secondary" href={withBase('/museum/')}>Browse the museum</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="timeline-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">Era</p>
        <h2 id="timeline-title">From 3000 BCE to the present.</h2>
      </div>
      <p class="lede">Chronology is the spine of the museum. Dates stay visible as BCE or CE labels, never as negative numbers.</p>
    </div>
    <TimelineStrip />
    <div class="stat-grid">
      <div class="stat-card"><strong>{works.length}</strong><span>records in the collection</span></div>
      <div class="stat-card"><strong>{facets.geography.length}</strong><span>places</span></div>
      <div class="stat-card"><strong>{facets.materials.length}</strong><span>materials</span></div>
    </div>
  </section>

  <section class="section" aria-labelledby="pathways-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">Curated entry points</p>
        <h2 id="pathways-title">Start with a way of looking.</h2>
      </div>
    </div>
    <div class="pathway-grid">
      {pathways.map((pathway) => (
        <a class="pathway" href={withBase(pathway.href)}>
          <strong>{pathway.label}</strong>
          <span>{pathway.note}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="highlights-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">Collection highlights</p>
        <h2 id="highlights-title">Objects with strong entry records.</h2>
      </div>
      <a class="text-link" href={withBase('/museum/')}>Browse all records</a>
    </div>
    <div class="rail">
      {highlights.slice(0, 8).map((work, index) => <WorkCard work={work} eager={index < 4} />)}
    </div>
  </section>

  <section class="section" aria-labelledby="recent-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">Newly prepared records</p>
        <h2 id="recent-title">Freshly surfaced from the corpus.</h2>
      </div>
    </div>
    <div class="rail">
      {recent.map((work) => <WorkCard work={work} />)}
    </div>
  </section>

  <section class="section" aria-labelledby="explore-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">Up close</p>
        <h2 id="explore-title">Every piece, from every angle.</h2>
      </div>
      <p class="lede">Open any sculpture to turn it around in 3D, change the light, and look right at the surface — or just browse the photographs. No app, no sign-in.</p>
    </div>
  </section>
</BaseLayout>
